package scanner;

/* --- 0. CONFIGURAÇÕES E IMPORTS --- */
import java.util.ArrayList;
import java.util.List;
import core.ast.*;
import core.ast.nodes.*;
import core.ast.nodes.literals.*;
import core.ast.nodes.expressions.*;
import core.ast.nodes.statements.*;

/* --- 1. TERMINAIS (Tokens do JFlex) --- */
terminal LPAREN, RPAREN, DOT, QUOTE, VECTOR_START, ARROW;
terminal KW_DEFINE, KW_IF, KW_SET, KW_LAMBDA, KW_BEGIN, KW_COND, KW_ELSE;
terminal KW_CASE, KW_AND, KW_OR, KW_LET, KW_LETSTAR, KW_LETREC, KW_DO, KW_DELAY;
terminal String IDENTIFIER, STRING, CHARACTER;
terminal Double NUMBER;
terminal Boolean BOOLEAN;

/* --- 2. NÃO-TERMINAIS (Tipados com a sua AST) --- */
non terminal ProgramNode program;
non terminal List<ASTNode> command_or_definition_star, command_or_definition_plus, body, sequence, expression_star;
non terminal List<IdentifierNode> def_formals, variable_plus, formals;
non terminal List<ASTNode> operand_star;
non terminal ASTNode command_or_definition, definition, expression, literal, self_evaluating, quotation;
non terminal ASTNode procedure_call, operator, operand, conditional, test, consequent, alternate;
non terminal ASTNode assignment, derived_expression, lambda_expression;
non terminal IdentifierNode variable;
non terminal ASTNode datum, simple_datum, compound_datum, list, abbreviation, vector;
non terminal Object symbol, datum_plus, abbrev_prefix; /* Tipos genéricos para nós não mapeados ainda */

// (Demais não terminais de açúcar sintático como cond_clause, case_clause, etc., podem ficar genéricos temporariamente)
non terminal Object cond_clause_plus, case_clause_plus, test_star, binding_spec_star, iteration_spec_star;
non terminal Object cond_clause, recipient, case_clause, binding_spec, iteration_spec, init_val, step;

/* --- 3. REGRAS GRAMATICAIS COM CONSTRUÇÃO DA AST --- */

program ::= command_or_definition_star:list
          {: RESULT = new ProgramNode(listleft, listright, list); :} ;

command_or_definition_star ::= /* empty */
                             {: RESULT = new ArrayList<ASTNode>(); :}
                             | command_or_definition_star:list command_or_definition:item
                             {: list.add(item); RESULT = list; :} ;

command_or_definition_plus ::= command_or_definition:item
                             {: List<ASTNode> l = new ArrayList<>(); l.add(item); RESULT = l; :}
                             | command_or_definition_plus:list command_or_definition:item
                             {: list.add(item); RESULT = list; :} ;

command_or_definition ::= expression:e {: RESULT = e; :}
                        | definition:d {: RESULT = d; :} ;

definition ::= LPAREN KW_DEFINE variable:v expression:e RPAREN
             {: RESULT = new DefineNode(vleft, vright, v, e); :}
             | LPAREN KW_DEFINE LPAREN variable:v def_formals:f RPAREN body:b RPAREN
             {: /* Açúcar sintático: Transforma (define (func x) ...) em (define func (lambda (x) ...)) */
                LambdaNode lam = new LambdaNode(fleft, fright, f, b);
                RESULT = new DefineNode(vleft, vright, v, lam);
             :} ;

def_formals ::= variable_plus:list {: RESULT = list; :}
              | variable_plus:list DOT variable:v {: list.add(v); RESULT = list; :} ;

expression ::= variable:v {: RESULT = v; :}
             | literal:l {: RESULT = l; :}
             | procedure_call:p {: RESULT = p; :}
             | lambda_expression:l {: RESULT = l; :}
             | conditional:c {: RESULT = c; :}
             | assignment:a {: RESULT = a; :}
             | derived_expression:d {: RESULT = d; :} ;

variable ::= IDENTIFIER:id {: RESULT = new IdentifierNode(idleft, idright, id); :} ;

literal ::= quotation:q {: RESULT = q; :}
          | self_evaluating:s {: RESULT = s; :} ;

self_evaluating ::= BOOLEAN:b {: RESULT = new BooleanNode(bleft, bright, b); :}
                  | NUMBER:n {: RESULT = new NumberNode(nleft, nright, n); :}
                  | STRING:s {: RESULT = new StringNode(sleft, sright, s); :}
                  | CHARACTER:c {: RESULT = new StringNode(cleft, cright, c); :} ;

procedure_call ::= LPAREN operator:op operand_star:args RPAREN
                 {: RESULT = new ProcedureCallNode(opleft, opright, op, args); :} ;

operator ::= expression:e {: RESULT = e; :} ;

operand ::= expression:e {: RESULT = e; :} ;

operand_star ::= /* empty */ {: RESULT = new ArrayList<ASTNode>(); :}
               | operand_star:list operand:op {: list.add(op); RESULT = list; :} ;

lambda_expression ::= LPAREN KW_LAMBDA formals:f body:b RPAREN
                    {: RESULT = new LambdaNode(fleft, fright, f, b); :} ;

formals ::= LPAREN RPAREN {: RESULT = new ArrayList<IdentifierNode>(); :}
          | LPAREN variable_plus:v RPAREN {: RESULT = v; :}
          | LPAREN variable_plus:v DOT variable:last RPAREN {: v.add(last); RESULT = v; :}
          | variable:v {: List<IdentifierNode> l = new ArrayList<>(); l.add(v); RESULT = l; :} ;

variable_plus ::= variable:v {: List<IdentifierNode> l = new ArrayList<>(); l.add(v); RESULT = l; :}
                | variable_plus:list variable:v {: list.add(v); RESULT = list; :} ;

body ::= command_or_definition_plus:list {: RESULT = list; :} ;

sequence ::= expression:e {: List<ASTNode> l = new ArrayList<>(); l.add(e); RESULT = l; :}
           | sequence:list expression:e {: list.add(e); RESULT = list; :} ;

expression_star ::= /* empty */ {: RESULT = new ArrayList<ASTNode>(); :}
                  | expression_star:list expression:e {: list.add(e); RESULT = list; :} ;

conditional ::= LPAREN KW_IF test:t consequent:c alternate:a RPAREN
              {: RESULT = new IfNode(tleft, tright, t, c, a); :} ;

test ::= expression:e {: RESULT = e; :} ;

consequent ::= expression:e {: RESULT = e; :} ;

alternate ::= expression:e {: RESULT = e; :}
            | /* empty */ {: RESULT = null; :} ;

assignment ::= LPAREN KW_SET variable:v expression:e RPAREN
             {: RESULT = new AssignmentNode(vleft, vright, v, e); :} ;

/* Deixei o 'begin' gerando um nó e comentei as outras derivadas por enquanto para focarmos no core! */
derived_expression ::=
      LPAREN KW_BEGIN sequence:seq RPAREN {: RESULT = new BeginNode(seqleft, seqright, seq); :}
    /* | DEMAIS REGRAS OMITIDAS AQUI PARA BREVIDADE DA COMPILAÇÃO, PODEMOS MAPEÁ-LAS DEPOIS */
    ;

iteration_spec ::= LPAREN variable init_val step RPAREN
                 | LPAREN variable init_val RPAREN ;

init_val ::= expression ;

step ::= expression ;

/* Abaixo, deixamos regras de Datum genéricas para não quebrar as referências, mas o foco é na AST das expressões acima. */
datum ::= self_evaluating:s {: RESULT = s; :} ;
quotation ::= QUOTE datum:d {: RESULT = d; :} ;